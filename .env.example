# ── Icelandic Tutor — Environment Configuration ──────────────────────────────

# LLM Backend
# Set to "ollama" to use Ollama on the local GPU host (recommended)
# Set to "anthropic" to use the Claude API
LLM_PROVIDER=ollama

# Ollama — runs on the same host as Docker (RTX 5080, 16 GB VRAM)
# mistral-nemo:12b fits comfortably; larger models require more VRAM
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral-nemo:12b

OTEL_COLLECTOR_URL=http://10.10.10.1:4318

# Anthropic fallback
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LiteLLM proxy (set LLM_PROVIDER=litellm to use)
#LITELLM_URL=http://your-litellm-host:4000
#LITELLM_API_KEY=sk-12345
#LITELLM_MODEL=ollama/mistral-nemo:12b

# Whisper STT
# Options: tiny, base, small, medium, large-v2, large-v3
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda       # cuda | cpu
WHISPER_COMPUTE=float16   # float16 | int8

# TTS Voice
# Piper Icelandic voice model name
TTS_VOICE=is_IS-bui-medium
